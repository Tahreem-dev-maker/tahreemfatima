<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard — Uncle Leo's Bakery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* ── Tokens ── */
        :root {
            --cream:   #fdf6ec;
            --brown:   #4a2c0a;
            --caramel: #c07c2e;
            --gold:    #e8a835;
            --rust:    #b84c1e;
            --text:    #2d1a06;
            --muted:   #8c6d4f;
            --border:  #e8d9c4;
            --card-bg: #fff9f2;
            --radius:  10px;
            --shadow:  0 4px 20px rgba(74,44,10,.08);
            --sidebar-w: 220px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #f5ede0;
            color: var(--text);
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--brown);
            display: flex;
            flex-direction: column;
            padding: 2rem 0;
            position: fixed;
            top: 0; left: 0;
            height: 100vh;
            z-index: 10;
        }

        .sidebar-logo {
            font-family: 'Playfair Display', serif;
            color: var(--gold);
            font-size: 1.15rem;
            font-weight: 700;
            padding: 0 1.5rem 2rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
            letter-spacing: .02em;
        }

        .sidebar-logo span {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: .7rem;
            color: var(--muted);
            font-weight: 400;
            letter-spacing: .1em;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .sidebar nav {
            margin-top: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: .25rem;
            padding: 0 .75rem;
        }

        .sidebar nav a {
            color: #e8d9c4;
            text-decoration: none;
            padding: .65rem .85rem;
            border-radius: 8px;
            font-size: .88rem;
            transition: background .2s, color .2s;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: rgba(232,168,53,.15);
            color: var(--gold);
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 1.5rem;
            border-top: 1px solid rgba(255,255,255,.1);
        }

        .sidebar-footer a {
            color: var(--muted);
            font-size: .8rem;
            text-decoration: none;
            transition: color .2s;
        }

        .sidebar-footer a:hover { color: var(--gold); }

        /* ── Main content ── */
        .main {
            margin-left: var(--sidebar-w);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── Top bar ── */
        .topbar {
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--brown);
        }

        .topbar-actions {
            display: flex;
            gap: .75rem;
        }

        /* ── Buttons ── */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            height: 38px;
            padding: 0 1.2rem;
            border-radius: 8px;
            font-family: inherit;
            font-size: .85rem;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .2s;
            white-space: nowrap;
        }

        .btn-primary { background: var(--caramel); color: white; }
        .btn-primary:hover { background: var(--rust); }

        .btn-edit {
            background: #f0e8d8;
            color: var(--brown);
            border: 1px solid var(--border);
            padding: 0 .85rem;
            height: 32px;
            font-size: .8rem;
        }
        .btn-edit:hover { background: var(--gold); color: var(--brown); }

        .btn-delete {
            background: #fdecea;
            color: var(--rust);
            border: 1px solid #f5ccc8;
            padding: 0 .85rem;
            height: 32px;
            font-size: .8rem;
        }
        .btn-delete:hover { background: var(--rust); color: white; }

        /* ── Stats row ── */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 1rem;
            padding: 1.75rem 2rem 0;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.25rem 1.5rem;
            box-shadow: var(--shadow);
        }

        .stat-card .label {
            font-size: .72rem;
            font-weight: 500;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: .35rem;
        }

        .stat-card .value {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--brown);
        }

        /* ── Table section ── */
        .table-section {
            margin: 1.75rem 2rem 2rem;
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .table-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.1rem 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .table-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brown);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead tr {
            background: #fdf3e7;
        }

        th {
            text-align: left;
            padding: .75rem 1.2rem;
            font-size: .73rem;
            font-weight: 600;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: .85rem 1.2rem;
            font-size: .875rem;
            border-bottom: 1px solid #f5ede0;
            vertical-align: middle;
        }

        tbody tr:last-child td { border-bottom: none; }

        tbody tr:hover { background: #fffaf4; }

        .product-img {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid var(--border);
        }

        .img-placeholder {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            background: #f0e8d8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .category-badge {
            display: inline-block;
            background: #f0e8d8;
            color: var(--brown);
            font-size: .72rem;
            font-weight: 600;
            padding: .2rem .65rem;
            border-radius: 999px;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .stock-ok  { color: #4a8a4a; font-weight: 500; }
        .stock-low { color: var(--rust); font-weight: 500; }

        .actions-cell {
            display: flex;
            gap: .5rem;
        }

        /* ── Empty state ── */
        .empty-row td {
            text-align: center;
            padding: 3rem;
            color: var(--muted);
        }
    </style>
</head>
<body>

    <!-- ── SIDEBAR ─────────────────────────────────────────────────────────── -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            🥐 Uncle Leo's
            <span>Admin Panel</span>
        </div>

        <nav>
            <a href="/admin" class="active">📊 Dashboard</a>
            <a href="/admin/products/new">➕ Add Product</a>
            <a href="/products">🛍 View Store</a>
            <a href="/">🏠 Home</a>
        </nav>

        <div class="sidebar-footer">
            <a href="/">← Back to site</a>
        </div>
    </aside>

    <!-- ── MAIN ───────────────────────────────────────────────────────────── -->
    <div class="main">

        <!-- Top bar -->
        <div class="topbar">
            <h1>Product Dashboard</h1>
            <div class="topbar-actions">
                <a href="/admin/products/new" class="btn btn-primary">+ Add Product</a>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="label">Total Products</div>
                <div class="value"><%= products.length %></div>
            </div>
            <div class="stat-card">
                <div class="label">Low Stock</div>
                <div class="value"><%= products.filter(p => p.stock < 15).length %></div>
            </div>
            <div class="stat-card">
                <div class="label">Avg Price</div>
                <div class="value">
                    $<%= products.length ? (products.reduce((s,p) => s + p.price, 0) / products.length).toFixed(2) : '0.00' %>
                </div>
            </div>
            <div class="stat-card">
                <div class="label">Categories</div>
                <div class="value"><%= [...new Set(products.map(p => p.category.toLowerCase()))].length %></div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-section">
            <div class="table-header">
                <h2>All Products</h2>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Rating</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products.length === 0) { %>
                        <tr class="empty-row">
                            <td colspan="7">No products found. <a href="/admin/products/new">Add one?</a></td>
                        </tr>
                    <% } else { %>
                        <% products.forEach(product => { %>
                            <tr>
                                <td>
                                    <% if (product.image) { %>
                                        <img src="<%= product.image %>" alt="<%= product.name %>" class="product-img" />
                                    <% } else { %>
                                        <div class="img-placeholder">🥐</div>
                                    <% } %>
                                </td>
                                <td><strong><%= product.name %></strong></td>
                                <td><span class="category-badge"><%= product.category %></span></td>
                                <td>$<%= product.price.toFixed(2) %></td>
                                <td class="<%= product.stock < 15 ? 'stock-low' : 'stock-ok' %>">
                                    <%= product.stock < 15 ? '⚠ ' : '✓ ' %><%= product.stock %>
                                </td>
                                <td>⭐ <%= product.rating %></td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="/admin/products/<%= product._id %>/edit" class="btn btn-edit">Edit</a>

                                        <form action="/admin/products/<%= product._id %>/delete" method="POST">
                                            <button
                                                type="submit"
                                                class="btn btn-delete"
                                                onclick="return confirm('Delete \'<%= product.name %>\'? This cannot be undone.')">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

    </div><!-- /.main -->

</body>
</html>
