<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Add Product — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css"/>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <span>🥐</span>
            <span>Uncle Leo's</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="nav-item">📋 Dashboard</a>
            <a href="/admin/new" class="nav-item active">➕ Add Product</a>
            <a href="/products" class="nav-item">🛍 View Store</a>
            <a href="/" class="nav-item">🏠 Homepage</a>
        </nav>
    </aside>

    <main class="admin-main">

        <div class="admin-topbar">
            <div>
                <h1 class="admin-title">Add New Product</h1>
                <p class="admin-subtitle">Fill in all required fields</p>
            </div>
            <a href="/admin" class="admin-btn admin-btn--ghost">← Back</a>
        </div>

        <!-- Validation errors -->
        <% if (errors.length > 0) { %>
            <div class="error-box">
                <ul>
                    <% errors.forEach(e => { %><li><%= e %></li><% }) %>
                </ul>
            </div>
        <% } %>

        <!--
            enctype="multipart/form-data" is REQUIRED when the form
            includes a file upload — without it, multer gets nothing
        -->
        <form class="admin-form" action="/admin/new" method="POST" enctype="multipart/form-data">

            <div class="form-row">
                <div class="form-group">
                    <label for="name">Product Name *</label>
                    <input type="text" id="name" name="name" placeholder="e.g. Chocolate Croissant" required/>
                </div>
                <div class="form-group">
                    <label for="category">Category *</label>
                    <input type="text" id="category" name="category" placeholder="e.g. Pastries" required/>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="price">Price ($) *</label>
                    <input type="number" id="price" name="price" placeholder="0.00" step="0.01" min="0" required/>
                </div>
                <div class="form-group">
                    <label for="stock">Stock *</label>
                    <input type="number" id="stock" name="stock" placeholder="0" min="0" required/>
                </div>
                <div class="form-group">
                    <label for="rating">Rating (0–5)</label>
                    <input type="number" id="rating" name="rating" placeholder="0.0" step="0.1" min="0" max="5"/>
                </div>
            </div>

            <div class="form-group">
                <label for="image">Product Image</label>
                <input type="file" id="image" name="image" accept="image/*" class="file-input"/>
                <small>JPG, PNG, WEBP, AVIF accepted</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="admin-btn admin-btn--primary">Save Product</button>
                <a href="/admin" class="admin-btn admin-btn--ghost">Cancel</a>
            </div>

        </form>

    </main>

</body>
</html>
