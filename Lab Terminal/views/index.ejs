<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Uncle Leo's Bakery</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="home">

    <header>
        <div class="head">

            <button class="hamburger" id="hamburger-btn" aria-label="Toggle navigation" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav id="main-nav">
                <ul class="head-list">
                    <li><a href="/">Home</a></li>
                    <li><a href="#">Our story</a></li>
                    <li><a href="/products">Products</a></li>
                    <li><a href="/onsale-products">On Sale</a></li>
                    <li><a href="#">Shop</a></li>
                    <li><a href="/contact">Contact us</a></li>
                    <li class="admin-panel-item"><a href="/admin" class="admin-panel">Admin Panel</a></li>
                </ul>
            </nav>

            <div class="head-right">
    <span><a href="/">Logo</a></span>
    
    <% if (user) { %>
        <span><a href="/logout">Logout</a></span>
    <% } else { %>
        <span><a href="/login">Login</a></span>
        <span><a href="/register">Register</a></span>
    <% } %>

    <span><a href="#">Cart</a></span>
</div>

        </div>
    </header>

    <section class="hero">
        <div class="left">
            <h1>French Bakery and Patisserie</h1>
            <p><b>BAKING WITH LOVE</b> TO SPREAD HAPPINESS</p>
            <span class="btn"><a href="#">shop now</a></span>
        </div>
        <div class="right">
            <img src="/bakery.jpg" alt="bakery">
        </div>
    </section>

    <section class="section2">
        <div class="text">
            <h1>
                <span id="teal">A piece of</span>
                <span id="orange">France in New Zealand</span>
            </h1>
            <p>Come and enjoy our delightful variety of artisan breads, scrumptious sweet treats, and amazing barista-made coffee!</p>
            <span class="btn2"><a href="#">buy now</a></span>
            <div class="small-imgs">
                <img src="/bakery3.avif" alt="bakery3">
                <img src="/bak4.avif" alt="bakery4">
                <img src="/bak5.avif" alt="bakery5">
            </div>
        </div>
        <div class="img2">
            <img src="/bakery2.jpg" alt="bakery2">
        </div>
    </section>

    <section class="section3">
        <div class="text3">
            <h1>CHRISTMAS PICKS</h1>
            <p>Shop now and treat yourself to our Christmas bestsellers, lovingly crafted for the season. Don't miss out on these seasonal delights!</p>
        </div>
    </section>

    <section class="section4">
        <div class="left2">
            <p>OUR STORY</p>
            <h1>The Speciality Journey</h1>
            <p>Discover the story behind Uncle Leo's Bakery! From humble beginnings to becoming the most beloved bakery in Wellington, our journey is one of passion, dedication, and a love for creating the finest baked goods. Learn more about how we started and what makes us a local favorite!</p>
            <a class="contact" href="/contact">Contact us &#8594;</a>
        </div>
        <div class="imgPart">
            <img src="/bak6.avif" alt="uncleLeo">
        </div>
    </section>

    <section class="foot">
        <div class="top">
            <div class="address">
                <p>Address</p>
                <p class="addr-detail">305 Evans Bay Parade, Hataitai, Wellington 602</p>
                <a href="#">Email: uncleleobakery@gmail.com</a><br>
                <a href="#">Tel: 04 333 2988</a>
            </div>
            <div class="quickLink">
                <p>Quicklinks</p>
                <a href="#">Shop</a><br>
                <a href="#">Our Story</a><br>
                <a href="/contact">Contact</a><br>
            </div>
            <div class="Follow">
                <p>Follow</p>
                <a href="#">Facebook</a><br>
                <a href="#">Instagram</a>
            </div>
        </div>
    </section>

    <footer></footer>

    <script src="/script.js"></script>
</body>
</html>
